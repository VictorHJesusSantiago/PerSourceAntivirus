<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="ContentBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ContentBorder" Color="#E0E0E0"/>

    <!-- Text. Contrast ratios are against CardBackground (#FFFFFF), WCAG 2.1 AA needs >= 4.5:1
         for body text; all three clear it with margin:
         Primary  #1A1A1A -> 17.4:1   Secondary #4A4A4A -> 8.9:1   Muted #6B6B6B -> 5.3:1 -->
    <SolidColorBrush x:Key="ContentTextPrimary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ContentTextSecondary" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ContentTextMuted" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF"/>
</ResourceDictionary>
