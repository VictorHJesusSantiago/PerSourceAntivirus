<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="ContentBackground" Color="#181825"/>
    <SolidColorBrush x:Key="CardBackground" Color="#242438"/>
    <SolidColorBrush x:Key="SubtleBackground" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="ContentBorder" Color="#3A3A52"/>

    <!-- Text. Contrast ratios are against CardBackground (#242438), WCAG 2.1 AA needs >= 4.5:1
         for body text; all three clear it:
         Primary  #F0F0F5 -> 14.6:1   Secondary #C8C8D4 -> 9.7:1   Muted #9A9AAB -> 5.4:1 -->
    <SolidColorBrush x:Key="ContentTextPrimary" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="ContentTextSecondary" Color="#C8C8D4"/>
    <SolidColorBrush x:Key="ContentTextMuted" Color="#9A9AAB"/>
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF"/>
</ResourceDictionary>
